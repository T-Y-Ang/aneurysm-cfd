| Synthetic intracranial aneurysm CFD demonstration                          |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

// Kinematic pressure dimensions: m^2/s^2
dimensions      [0 2 -2 0 0 0 0];

// Initial reference pressure throughout the fluid domain
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    walls
    {
        type            zeroGradient;
    }
}
