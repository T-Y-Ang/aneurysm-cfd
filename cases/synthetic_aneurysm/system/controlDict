
/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM 14                                                               |
| Synthetic intracranial aneurysm CFD demonstration                          |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// OpenFOAM solver.
application     foamRun;
solver          incompressibleFluid;

// Simulation control.
// For a steady-state simulation, these steps represent iterations,
// not elapsed physiological time.

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         500;

deltaT          1;

// Save calculated fields every 100 iterations.
writeControl    timeStep;
writeInterval   100;

// Allow configuration changes while running.
runTimeModifiable true;
