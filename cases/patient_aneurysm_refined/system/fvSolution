FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.1;
        smoother        GaussSeidel;
    }

    pcorr
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0;
        smoother        GaussSeidel;
    }

    "(U|k|epsilon|omega|f|v2)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-05;
        relTol          0.1;
    }
}

// -------------------------------------------------------------
// STEADY-STATE PRESSURE-VELOCITY COUPLING
// -------------------------------------------------------------
//
// SIMPLE solves the steady incompressible flow equations.
//
// Additional non-orthogonal corrections help accommodate
// our irregular tetrahedral mesh.
//
// The residual thresholds are initial convergence targets,
// not proof that the solution is physically accurate.
// -------------------------------------------------------------

SIMPLE
{
    nNonOrthogonalCorrectors 2;

    consistent no;

    residualControl
    {
        p               1e-5;
        U               1e-6;
    }
}

// -------------------------------------------------------------
// UNDER-RELAXATION
// -------------------------------------------------------------
//
// Conservative relaxation factors reduce the magnitude of
// changes between SIMPLE iterations, improving stability.
// -------------------------------------------------------------

relaxationFactors
{
    fields
    {
        p               0.3;
    }

    equations
    {
        U               0.5;
    }
}


