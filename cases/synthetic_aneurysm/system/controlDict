FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// Placeholder settings for initial mesh conversion.
// We will configure the actual blood-flow solver later.

application     foamRun;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1;

deltaT          0.001;

writeControl    timeStep;
writeInterval   100;

runTimeModifiable true;
